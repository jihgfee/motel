opam-version: "2.0"
maintainer: "Jonas Kastberg Hinrichsen"
synopsis: "MoTeL: A Modal Temporal Logic Proofmode"
homepage: "TBD"
authors: "The MoTeL Team"
license: "BSD-3-Clause"
